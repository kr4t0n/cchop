# cchop init creates credentials.env next to cchop.json with generated keys.
# Environment variables take precedence over that file.
CCHOP_GATEWAY_TOKEN=replace-with-a-random-secret-at-least-24-characters
CCHOP_ADMIN_TOKEN=replace-with-a-different-random-secret-at-least-24-characters
# Optional configuration overrides:
# CCHOP_CONFIG=/etc/cchop/cchop.json
# CCHOP_HOST=0.0.0.0
# CCHOP_PORT=8787
# CCHOP_ADMIN_HOST=127.0.0.1
# CCHOP_ADMIN_PORT=8788
# CCHOP_FINGERPRINT=/absolute/path/to/fingerprint.json
# CCHOP_CLAUDE_CREDENTIALS=/home/your-user/.claude/.credentials.json
# OAuth credentials are read from that private file, never from client settings.
# The following public OAuth application settings default to the source document:
# CCHOP_OAUTH_TOKEN_URL=https://platform.claude.com/v1/oauth/token
# CCHOP_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# CCHOP_UPSTREAM=https://api.anthropic.com
# CCHOP_PUBLIC_URL=https://cchop.example.com
